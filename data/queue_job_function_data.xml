<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Le retry_pattern est un filet de sécurité pour un job qui
            échouerait franchement (bug, perte de connexion base de
            données) : la relance métier propre à chaque échec d'appel IA
            est gérée ticket par ticket à l'intérieur du job lui-même
            (voir js.depense.ticket._register_ai_failure), pas ici.
        -->
        <record id="job_function_ticket_batch_vision" model="queue.job.function">
            <field name="model_id" ref="model_js_depense_ticket"/>
            <field name="method">_job_batch_vision</field>
            <field name="channel_id" ref="channel_js_depenses_vision"/>
            <field name="retry_pattern">{1: 60, 2: 300, 3: 1800}</field>
        </record>

        <record id="job_function_ticket_batch_text" model="queue.job.function">
            <field name="model_id" ref="model_js_depense_ticket"/>
            <field name="method">_job_batch_text</field>
            <field name="channel_id" ref="channel_js_depenses_text"/>
            <field name="retry_pattern">{1: 60, 2: 300, 3: 1800}</field>
        </record>

    </data>
</odoo>
