<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="js_ai_log_view_list" model="ir.ui.view">
        <field name="name">js.ai.log.list</field>
        <field name="model">js.ai.log</field>
        <field name="arch" type="xml">
            <list string="Échanges IA" create="false" edit="false"
                  decoration-danger="not success">
                <field name="create_date" string="Date"/>
                <field name="ticket_id"/>
                <field name="provider_id"/>
                <field name="model_name" optional="show"/>
                <field name="step"/>
                <field name="iteration"/>
                <field name="image_count" optional="hide"/>
                <field name="duration" sum="Durée totale"/>
                <field name="success" widget="boolean_toggle"/>
                <field name="error_message" optional="show"/>
            </list>
        </field>
    </record>

    <record id="js_ai_log_view_form" model="ir.ui.view">
        <field name="name">js.ai.log.form</field>
        <field name="model">js.ai.log</field>
        <field name="arch" type="xml">
            <form string="Échange IA" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="ticket_id"/>
                            <field name="provider_id"/>
                            <field name="model_name"/>
                            <field name="step"/>
                            <field name="iteration"/>
                        </group>
                        <group>
                            <field name="duration"/>
                            <field name="image_count"/>
                            <field name="success"/>
                            <field name="error_message"/>
                            <field name="create_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Requête" name="prompt">
                            <field name="system_prompt" readonly="1"/>
                            <separator string="Message"/>
                            <field name="prompt" readonly="1"/>
                        </page>
                        <page string="Réponse" name="response">
                            <field name="response" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="js_ai_log_action" model="ir.actions.act_window">
        <field name="name">Journal des échanges IA</field>
        <field name="res_model">js.ai.log</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
