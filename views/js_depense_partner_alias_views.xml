<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="js_depense_partner_alias_view_list" model="ir.ui.view">
        <field name="name">js.depense.partner.alias.list</field>
        <field name="model">js.depense.partner.alias</field>
        <field name="arch" type="xml">
            <list string="Correspondances d'enseignes" editable="bottom">
                <field name="alias_raw"/>
                <field name="alias_key" readonly="1" optional="show"/>
                <field name="partner_id"/>
                <field name="hit_count" readonly="1" optional="show"/>
                <field name="last_used" readonly="1" optional="hide"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
                <field name="company_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="js_depense_partner_alias_view_search" model="ir.ui.view">
        <field name="name">js.depense.partner.alias.search</field>
        <field name="model">js.depense.partner.alias</field>
        <field name="arch" type="xml">
            <search string="Correspondances d'enseignes">
                <field name="alias_raw"/>
                <field name="partner_id"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_partner" string="Fournisseur"
                            context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="js_depense_partner_alias_action" model="ir.actions.act_window">
        <field name="name">Correspondances d'enseignes</field>
        <field name="res_model">js.depense.partner.alias</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="js_depense_partner_alias_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune correspondance enregistrée
            </p>
            <p>
                Les enseignes imprimées sur les tickets ne correspondent
                jamais exactement au nom du fournisseur dans Odoo. Ces
                correspondances se créent automatiquement dès que vous
                rattachez un ticket à un fournisseur.
            </p>
        </field>
    </record>

</odoo>
